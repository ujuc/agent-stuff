{
  "respectGitignore": true,
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "0",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git commit*)",
      "Bash(git add*)",
      "Bash(git push*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit -m \"$\\(cat <<''EOF''\nrefactor\\(claude\\): Claude 4 베스트 프랙티스 기반으로 핵심 규칙을 개선하다\n\nPhase 1: 핵심 파일 개선\n\nsystem-rules.md:\n- 섹션 제목 한글화 \\(Core Principles → 핵심 원칙\\)\n- 강조 표현 완화 \\(CRITICAL, NEVER → 자연스러운 표현\\)\n- 각 규칙에 이유/컨텍스트 추가\n- ''코드 탐색 먼저'' 규칙 신규 추가\n- ''하드코딩 금지'' 테스트 규칙 신규 추가\n\ntechnical-standards.md:\n- 전체 한글화\n- ''과잉 엔지니어링 방지'' 섹션 신규 추가\n- Claude 4.5 최적화 메타 정보 추가\n\n🤖 Generated with [Claude Code]\\(https://claude.com/claude-code\\)\n\nCo-Authored-By: Claude Opus 4.5 <noreply@anthropic.com>\nEOF\n\\)\")",
      "Bash(git commit:*)",
      "Bash(mkdir:*)",
      "Skill(commit)",
      "Skill(commit:*)",
      "Bash(git show:*)",
      "Bash(git -C /Users/ujuc/.config/dotrc diff HEAD -- claude/guides/version-control.md claude/skills/commit/SKILL.md)",
      "Bash(git -C /Users/ujuc/.config/dotrc show HEAD:claude/guides/version-control.md)",
      "Bash(git -C /Users/ujuc/.config/dotrc log --all --grep=\"footer\\\\|agent\" --oneline -20)",
      "Bash(git -C /Users/ujuc/.config/dotrc show 1c6bc59)",
      "Bash(env)",
      "Bash(git -C /Users/ujuc/.config/dotrc log --all --grep=\"footer\" --oneline -30)",
      "Bash(git -C /Users/ujuc/.config/dotrc log --all --author=\"Amp\" --oneline)",
      "Bash(find:*)",
      "Bash(git -C /Users/ujuc/.config/dotrc diff HEAD)",
      "WebFetch(domain:agents.md)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:github.blog)",
      "Bash(git config:*)",
      "mcp__acp__Write",
      "mcp__acp__Edit",
      "mcp__acp__Bash",
      "Bash(wc -l:*)",
      "Bash(uv:*)",
      "Bash(git -C:*)",
      "Bash(which jq:*)",
      "Bash(bash agents/claude/skills/generate-skills/scripts/validate-skill.sh agents/claude/skills/generate-skills/)",
      "Bash(python3:*)",
      "Bash(bash agents/claude/skills/generate-skills/scripts/validate-skill.sh agents/claude/skills/generate-skills)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(gh api:*)",
      "Bash(bash /Users/ujuc/.config/dotrc/agents/claude/skills/generate-skills/scripts/validate-skill.sh /Users/ujuc/.config/dotrc/agents/claude/skills/generate-skills)",
      "Bash(bash /Users/ujuc/.config/dotrc/agents/claude/skills/generate-skills/scripts/validate-skill.sh /Users/ujuc/.config/dotrc/agents/claude/skills/autoresearch)",
      "Bash(for skill:*)",
      "Bash(do)",
      "Bash(echo \"=== $skill/references/ ===\")",
      "Read(//Users/ujuc/.claude/skills/$skill/**)",
      "Bash(done)",
      "Bash(bash /Users/ujuc/.config/dotrc/agents/claude/skills/generate-skills/scripts/validate-skill.sh /Users/ujuc/.config/dotrc/agents/claude/skills/commit)",
      "Bash(bash /Users/ujuc/.config/dotrc/agents/claude/skills/generate-skills/scripts/validate-skill.sh /Users/ujuc/.config/dotrc/agents/claude/skills/generate-claude-md)",
      "Bash(mise which:*)",
      "Bash(bash -c 'echo \"$\\(\"$HOME/.local/bin/mise\" which bun\\)\"')",
      "Bash(find /Users/ujuc/.config/dotrc/agents/claude/skills -type f \\\\\\(-name *.md -o -name *.json -o -name *.yaml -o -name *.yml \\\\\\))",
      "Bash(mkdir -p /Users/ujuc/.config/dotrc/agents/.claude/agents)",
      "Bash(mkdir -p /Users/ujuc/.config/dotrc/agents/.claude/skills/maintain)",
      "Bash(git submodule:*)",
      "Bash(chmod +x:*)",
      "Bash(ollama list:*)",
      "Bash(bash /Users/ujuc/.claude/skills/gemma/scripts/query.sh \"hello\"3)",
      "Bash(bash:*)",
      "Bash(echo \"exit_code=$?\")",
      "Bash(yq --front-matter=extract eval . /Users/ujuc/.config/dotrc/agents/.claude/agents/health-checker.md)",
      "Bash(ls /Users/ujuc/.config/dotrc/Brewfile*)",
      "Bash(ls /Users/ujuc/.config/dotrc/install*)",
      "Bash(ls /Users/ujuc/.config/dotrc/bootstrap*)",
      "Bash(brew bundle:*)",
      "Bash(rtk ls:*)",
      "Bash(date -Iseconds)",
      "Bash(rtk grep:*)",
      "Bash(git grep:*)",
      "Bash(rtk git:*)",
      "Bash(echo \"--- exit=$? ---\")",
      "Bash(bash /Users/ujuc/.claude/skills/gemma/scripts/query.sh ':*)",
      "Read(//tmp/**)",
      "Bash(rtk read:*)",
      "Bash(command -v starship)",
      "Bash(grep -E '\\\\.sh$|\\\\.zsh$|\\\\.md$|\\\\.json$|\\\\.toml$|\\\\.conf|^[a-z]+rc')",
      "Bash(git check-ignore:*)",
      "Bash(rtk wc:*)",
      "Bash(unlink /Users/ujuc/.config/zed/settings.json)",
      "Bash(git rm:*)",
      "Bash(git revert:*)",
      "Bash(rtk tree *)",
      "Bash(rtk find *)",
      "Bash(rtk gh *)",
      "Bash(gh repo *)"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "plan",
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/annotation-review-prompt.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/polyglot-typecheck.sh",
            "timeout": 30000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/preserve-research-context.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c 'plugin_dir=$(ls -d \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"/plugins/cache/claude-hud/claude-hud/*/ 2>/dev/null | sed \"s:/*$:/:\" | awk -F/ '\"'\"'{ print $(NF-1) \"\\t\" $0 }'\"'\"' | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n | tail -1 | cut -f2-); exec \"$(\"$HOME/.local/bin/mise\" which bun)\" \"${plugin_dir}src/index.ts\"'"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "everything-claude-code@everything-claude-code": true,
    "claude-hud@claude-hud": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "harness@harness-marketplace": true,
    "amp-plugin-cc@amp-plugin-cc": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "everything-claude-code": {
      "source": {
        "source": "github",
        "repo": "affaan-m/everything-claude-code"
      }
    },
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    },
    "harness-marketplace": {
      "source": {
        "source": "github",
        "repo": "revfactory/harness"
      }
    },
    "amp-plugin-cc": {
      "source": {
        "source": "github",
        "repo": "ujuc/amp-plugin-cc"
      },
      "autoUpdate": true
    }
  },
  "language": "korean",
  "spinnerTipsEnabled": false,
  "alwaysThinkingEnabled": true,
  "advisorModel": "opus",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "theme": "dark-ansi",
  "teammateMode": "tmux",
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": true
}
