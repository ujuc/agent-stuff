{
  "respectGitignore": true,
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "0",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(git -C:*)",
      "Bash(rtk:*)",
      "Bash(gh:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(echo:*)",
      "Bash(grep:*)",
      "Bash(which:*)",
      "Bash(command -v:*)",
      "Bash(env)",
      "Bash(date:*)",
      "Bash(uv:*)",
      "Bash(brew bundle:*)",
      "Bash(mise which:*)",
      "Bash(ollama list:*)",
      "Bash(waza:*)",
      "Bash(yq:*)",
      "Bash(python3:*)",
      "Bash(bash:*)",
      "Bash(chmod +x:*)",
      "Bash(mkdir:*)",
      "Bash(ln:*)",
      "Bash(cat:*)",
      "Bash(jq:*)",
      "Bash(mv:*)",
      "Bash(rmdir:*)",
      "WebFetch(domain:agents.md)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:github.blog)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebSearch",
      "mcp__acp__Write",
      "mcp__acp__Edit",
      "mcp__acp__Bash",
      "Skill(commit)",
      "Skill(commit:*)",
      "Read(//tmp/**)"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "plan",
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/annotation-review-prompt.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/polyglot-typecheck.sh",
            "timeout": 30000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/preserve-research-context.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/gyeol-buffer-transcript.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c 'plugin_dir=$(ls -d \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"/plugins/cache/claude-hud/claude-hud/*/ 2>/dev/null | sed \"s:/*$:/:\" | awk -F/ '\"'\"'{ print $(NF-1) \"\\t\" $0 }'\"'\"' | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n | tail -1 | cut -f2-); exec \"$(\"$HOME/.local/bin/mise\" which bun)\" \"${plugin_dir}src/index.ts\"'"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "everything-claude-code@everything-claude-code": true,
    "claude-hud@claude-hud": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "harness@harness-marketplace": true,
    "amp-plugin-cc@amp-plugin-cc": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "codex@openai-codex": true,
    "warp@claude-code-warp": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "everything-claude-code": {
      "source": {
        "source": "github",
        "repo": "affaan-m/everything-claude-code"
      }
    },
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    },
    "harness-marketplace": {
      "source": {
        "source": "github",
        "repo": "revfactory/harness"
      }
    },
    "amp-plugin-cc": {
      "source": {
        "source": "github",
        "repo": "ujuc/amp-plugin-cc"
      },
      "autoUpdate": true
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    }
  },
  "language": "korean",
  "spinnerTipsEnabled": false,
  "alwaysThinkingEnabled": true,
  "advisorModel": "opus",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "theme": "dark-ansi",
  "teammateMode": "tmux",
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": true
}
